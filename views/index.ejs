<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7" crossorigin="anonymous">
</head>
<body>

    <nav class="navbar bg-dark border-bottom border-body  d-flex justify-content-center" data-bs-theme="dark">
        <!-- Navbar content -->
        <h1 class="navbar-brand "> Quora posts</h1>      
      </nav>
      <!-- <a href="http://localhost:<%=port%>/posts/new/" >add post</a> -->

      <div class="row row-cols-1 row-cols-md-3 mb-3 text-center ms-5">
        <div class="col">     
            <a  href="/posts/new/" style="text-decoration: none;" >
            
            <div class="card mb-4 rounded-3 shadow-sm shadow-lg p-3 mb-5 bg-body-tertiary rounded " style="width: 18rem;">
                   <div class="card-body" style=" background-color: rgb(11, 140, 187); color: white;  " >
                     <h5 class="card-title">  Add Post    </h5>
                     <p class="card-text"  > <br>
                        
                    </p>
                       
                   </div>
                  
                </a>
                 </div>
                
             </div>   



    <%   for( let post of result){ %>
        
         <div class="col ">     
         <div class="card mb-4 rounded-3 shadow-sm shadow-lg p-3 mb-5 bg-body-tertiary rounded " style="width: 18rem;">
                <div class="card-body">
                  <h5 class="card-title"> <%= post.username %>  </h5>
                  <p class="card-text"><%=  post.content %> <br>
                    </p>
                  </div>
                <div class="card-footer">
    <a class="btn btn-primary" style="display: inline-block;" href="/posts/<%=post.id%>/edit" style="text-decoration: none; color: white;"> edit </a> </button>
    <a class="btn btn-primary" style="display: inline-block;" href="/posts/<%=post.id%>" style="text-decoration: none; color: white;"> view in detail </a> </button>
                  <form method="post" style="display: inline-block;" action="/posts/<%=post.id%>?_method=DELETE">
                    <button class="btn btn-primary mt-2">Deleat</button>
                    
                    </form> 
                </div>
              </div>
          </div>
        
          <% } %>


